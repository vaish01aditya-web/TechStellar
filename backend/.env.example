# PostgreSQL connection string (Supabase, Railway, local Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/legal_metrology?schema=public"

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development

# The frontend origin allowed to call this API (CORS)
FRONTEND_URL="http://localhost:5173"
